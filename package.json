{
  "name": "rpn-bbcode",
  "version": "0.0.1",
  "repository": "TODO",
  "author": "RpNation",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "start": "rollup -c -w",
    "build": "rollup -c",
    "prepare": "husky",
    "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:prettier",
    "lint:js": "eslint {assets,admin/assets,test}/javascripts --cache --no-error-on-unmatched-pattern",
    "lint:css": "pnpm stylelint 'assets/stylesheets/**/*.scss' --allow-empty-input",
    "lint:prettier": "pnpm prettier 'assets/stylesheets/**/*.scss' '{assets,admin/assets,test}/javascripts/**/*.{js,gjs,ts,gts,mts,cts,hbs}' --check --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@bbob/types": "^4.2.0",
    "@discourse/lint-configs": "3.2.0",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.4.3",
    "eslint": "10.6.0",
    "husky": ">=6",
    "lint-staged": ">=10",
    "prettier": "3.8.1",
    "rollup": "^4.30.1",
    "stylelint": "17.5.0"
  },
  "dependencies": {
    "@bbob/core": "^4.2.0",
    "@bbob/html": "^4.2.0",
    "@bbob/plugin-helper": "^4.2.0",
    "@bbob/preset": "^4.2.0",
    "@bbob/preset-html5": "^4.2.0"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.{js,css,md}": "prettier --write"
  },
  "engines": {
    "node": ">= 22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "^10"
  },
  "private": true,
  "packageManager": "pnpm@10.28.0"
}
